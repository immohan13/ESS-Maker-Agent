# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4o

# ---- Target ESS agent (Copilot Studio) ----
# Option A (modern Copilot Studio agents): Token endpoint from
# Settings -> Channels -> Custom website (or Mobile app)
MCS_TOKEN_ENDPOINT=
# Option B (classic Bot Framework DirectLine channel): paste secret here.
DIRECTLINE_SECRET=
DIRECTLINE_ENDPOINT=https://directline.botframework.com/v3/directline
# Option C (M365/Teams-only agents): use AAD auth (run `az login` first).
# Schema name lives in Copilot Studio under Settings -> Advanced -> "Schema name".
MCS_ENV_ID=00000000-0000-0000-0000-000000000000
MCS_BOT_SCHEMA=

# ---- Power Platform / MCS (used by stub clients) ----
PP_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
PP_BOT_ID=00000000-0000-0000-0000-000000000000
PP_TENANT_ID=
PP_CLIENT_ID=
PP_CLIENT_SECRET=

# ---- MCP servers (when wired) ----
MCS_MCP_URL=
PP_MCP_URL=

# ---- Runtime ----
ESS_MAKER_WORKDIR=./.workdir
LOG_LEVEL=INFO

# ---- Application Insights (Copilot Studio runtime telemetry, optional) ----
APPINSIGHTS_APP_ID=
APPINSIGHTS_API_KEY=

# ---- ESS Doctor ----
# Folder of agent exports (*.yml) shown in the picker, and ESS template exports per persona
DOCTOR_SAMPLES_DIR=
DOCTOR_BASELINE_HR=
DOCTOR_BASELINE_IT=
DOCTOR_BASELINE_HUB=
# Copilot Studio runtime telemetry (Kusto). Only conversations from these tenant IDs can be inspected.
DOCTOR_ALLOWED_TENANTS=
DOCTOR_KUSTO_REGION=US
# Internal telemetry endpoints: ask the ESS team for the values; never commit them.
DOCTOR_KUSTO_DB=
DOCTOR_KUSTO_CLUSTERS=US=https://<cluster>.<region>.kusto.windows.net,EU-WEU=https://<cluster>.<region>.kusto.windows.net
DOCTOR_KUSTO_AAD_TENANT=
# Agent that "Load from Copilot Studio" reads directly (needs: az login --tenant <tenant> --scope 96ff4394-9197-43aa-b393-6a41652e21f8/.default)
DOCTOR_CS_TENANT_ID=
DOCTOR_CS_ENVIRONMENT_ID=
DOCTOR_CS_AGENT_ID=
# Copilot Studio gateway for your environment's region (internal; ask the ESS team)
DOCTOR_CS_GATEWAY=
